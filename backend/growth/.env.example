# === Pichangol Growth (puntos, zonas, verificación física) ===
# Integraciones en STUB: nada mueve dinero ni envía nada real todavía.

# Módulo de EXISTENCIA (Capa IA). Si se define, la verificación física lo llama
# por HTTP; si queda vacío, se usa el stub determinista.
# Ej.: https://canchas-app-lima-production.up.railway.app
EXISTENCIA_API_URL=

# Distancia máx (m) entre la ubicación declarada y la del sitio para considerar
# que la verificación física coincide.
VERIF_COINCIDENCIA_MAX_M=200

# Persistencia (opcional). Si se define, el estado se guarda como snapshot JSON en
# la tabla `growth_state` de Supabase/Postgres (sobrevive reinicios). Si queda
# vacío, el servicio corre 100% en memoria (fail-safe).
# Supabase → Project Settings → Database → Connection string (URI). Usar el pooler
# (puerto 6543) con sslmode=require. Ej.:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Panel web de administración (/admin). Token que protege el panel: el admin lo
# pega una vez en el navegador y se guarda localmente (no viaja en la URL). Sin
# token, el panel queda deshabilitado (503). Usa un valor largo y aleatorio.
ADMIN_PANEL_TOKEN=

# Nota: las reglas de incentivos (puntos, equivalencia, topes) NO van aquí; viven
# en la tabla config_incentivos (editable por /config/incentivos), nada hardcodeado.

# --- Concierge de reservas (primer agente de IA) ---
# API key de Anthropic (Claude) para el concierge. Sin ella, el asistente cae a
# una heurística (filtra por deporte + ordena por distancia). Consíguela en
# https://console.anthropic.com/ y ponla como secret en Railway.
ANTHROPIC_API_KEY=
# Modelo del concierge (opcional). Por defecto claude-opus-4-8; para bajar costo
# en alto volumen puedes usar claude-haiku-4-5.
CONCIERGE_MODEL=
