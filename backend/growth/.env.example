# === Pichangol Growth (puntos, zonas, verificación física) ===
# Integraciones en STUB: nada mueve dinero ni envía nada real todavía.

# Módulo de EXISTENCIA (Capa IA). Si se define, la verificación física lo llama
# por HTTP; si queda vacío, se usa el stub determinista.
# Ej.: https://canchas-app-lima-production.up.railway.app
EXISTENCIA_API_URL=

# Distancia máx (m) entre la ubicación declarada y la del sitio para considerar
# que la verificación física coincide.
VERIF_COINCIDENCIA_MAX_M=200

# Nota: las reglas de incentivos (puntos, equivalencia, topes) NO van aquí; viven
# en la tabla config_incentivos (editable por /config/incentivos), nada hardcodeado.
