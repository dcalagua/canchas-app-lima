# === Submódulo VERIFICACION DE EXISTENCIA (Pichangol) ===
# Todos los proveedores están en STUB: estas variables NO se usan hasta activar
# las integraciones reales. Copiar a .env y completar cuando corresponda.

# --- SUNAT (consulta de RUC, NO de DNI) ---
# Proveedor del adaptador: stub | factiliza | oficial
SUNAT_PROVIDER=stub
# Base de la API de Factiliza (consulta de RUC del negocio).
FACTILIZA_BASE_URL=https://api.factiliza.com/v1
# Token Factiliza (SECRETO). NUNCA versionar. Ponerlo aquí solo en el host.
# Si este token alguna vez se compartió, REGENERARLO en Factiliza.
FACTILIZA_API_TOKEN=

# --- Google Places ---
# Proveedor: stub | google
PLACES_PROVIDER=stub
GOOGLE_PLACES_API_KEY=

# --- Social ---
SOCIAL_PROVIDER=stub

# --- Scoring ---
# Umbrales de decisión (>= ALTO aprueba; >= MEDIO va a revisión manual)
VERIF_UMBRAL_ALTO=70
VERIF_UMBRAL_MEDIO=40
# (Opcional) pesos personalizados; DEBEN sumar 1.0
# VERIF_PESOS=sunat_activo:0.30,sunat_domicilio:0.20,maps_operativo:0.15,maps_distancia:0.20,social:0.15

# --- Cumplimiento / retención ---
# TTL (días) del único dato que persiste: el RESULTADO (bool + score + fecha)
VERIF_TTL_DIAS=365
# Clave de cifrado en reposo (solo si por excepción se conserva algo)
VERIF_ENCRYPTION_KEY=
